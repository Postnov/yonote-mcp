# Yonote API token
# Get it from: Settings → API Tokens in your Yonote workspace
YONOTE_TOKEN=your_yonote_api_token_here

# DeepSeek API key
# Get it from: https://platform.deepseek.com/
DEEPSEEK_KEY=your_deepseek_api_key_here

# Optional: Custom Yonote API URL (for self-hosted instances)
# YONOTE_BASE_URL=https://your-instance.yonote.ru/api
